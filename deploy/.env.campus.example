# Synthetic placeholders only. Copy to the matching ignored .env file and replace them.
# Do not source this file as shell code. Pass it with docker compose --env-file.
APP_JAR=/absolute/path/to/verified/eatwhat-0.0.1-SNAPSHOT.jar
JRE_IMAGE=eclipse-temurin:21-jre
POSTGRES_IMAGE=postgis/postgis:16-3.5
# This is the architecture used by the current isolated test fixture.
# Choose and verify the correct image/platform for the actual host before deployment.
POSTGRES_PLATFORM=linux/amd64
REDIS_IMAGE=redis:7.4-alpine
PG_DB=eatwhat
PG_ADMIN_USER=eatwhat_migrator
PG_ADMIN_PASSWORD=replace-with-unique-migration-password
PG_APP_USER=eatwhat_app
PG_APP_PASSWORD=replace-with-unique-application-password
REDIS_PASSWORD=replace-with-unique-local-redis-password
APP_OAUTH_URL=https://identity.example.invalid/replace-with-authorized-endpoint
APP_OAUTH_CALLBACK_URL=https://v50to.you/api/callback
APP_OAUTH_APP_SUCCESS_REDIRECT=https://v50to.you/app/auth/callback
APP_JWT_KEY=replace-with-compatible-existing-authentication-key
MAIL_HOST=mail.example.invalid
MAIL_PORT=465
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password
MAIL_FROM=replace-with-sender@example.invalid
MAIL_FROM_NAME=EatWhat
MAIL_SSL_ENABLED=true
MAIL_STARTTLS_ENABLED=false
SMS_ACCESS_KEY_ID=replace-with-approved-sms-access-key
SMS_ACCESS_KEY_SECRET=replace-with-approved-sms-secret
SMS_SIGN_NAME=replace-with-approved-sms-sign-name
# Tencent Cloud International CAPTCHA application and server-only cloud API credentials.
TENCENT_CAPTCHA_ENABLED=true
TENCENT_CAPTCHA_APP_ID=
TENCENT_CAPTCHA_APP_SECRET_KEY=
TENCENT_CAPTCHA_SECRET_ID=
TENCENT_CAPTCHA_SECRET_KEY=
# Required only when using temporary cloud API credentials.
TENCENT_CAPTCHA_SESSION_TOKEN=
TENCENT_CAPTCHA_TIMEOUT=5s
# Fetch a fresh aidEncrypted for every widget instance; never reuse it.
TENCENT_CAPTCHA_AID_ENCRYPTED_TTL=120s
# These sample session policies must be checked against the operator's existing policy.
SA_TOKEN_TIMEOUT=-1
SA_TOKEN_ACTIVE_TIMEOUT=259200
SA_TOKEN_CONCURRENT=false
SA_TOKEN_SHARE=false
S3_BUCKET=replace-with-provisioned-bucket
S3_ACCESS_KEY=replace-with-bucket-scoped-access-key
S3_SECRET_KEY=replace-with-bucket-scoped-secret
# Comma-separated existing application prefixes. Public access is disabled by default.
S3_ALLOWED_READ_PREFIXES=avatar/,activity/,restaurants/,foods/
S3_PUBLIC_READ_PREFIXES=
S3_PUBLIC_BASE_URL=

SITE_ID=campus-main
# Example only: replace with a freshly generated UUID once and retain across restarts.
SITE_INSTANCE_ID=00000000-0000-4000-8000-000000000001
APP_HTTP_PORT=18080
APP_BASE_URL=https://campus.example.invalid
# Must be reachable by clients; a Docker-only http://rustfs:9000 URL is unsuitable.
S3_ENDPOINT=https://campus-storage.example.invalid
S3_REGION=us-east-1
RUSTFS_IMAGE=rustfs/rustfs:replace-with-reviewed-version-or-digest
RUSTFS_ROOT_ACCESS_KEY=replace-with-unique-rustfs-admin-key
RUSTFS_ROOT_SECRET_KEY=replace-with-unique-rustfs-admin-secret
RUSTFS_API_PORT=19000
RUSTFS_CONSOLE_PORT=19001
