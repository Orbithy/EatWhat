[Unit]
Description=EatWhat Docker SMS-only relay destination port mapping
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -B /opt/eatwhat-sms-relay/apply-route.py
ExecStop=-/usr/sbin/nft delete table ip eatwhat_sms_relay
TimeoutStartSec=75
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
